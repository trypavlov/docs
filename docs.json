{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Trig",
  "colors": {
    "primary": "#5A7A99",
    "light": "#7392B0",
    "dark": "#4A6580"
  },
  "css": "/styles/custom.css",
  "favicon": "/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "icon": "envelope",
          "href": "mailto:support@trig.com"
        }
      ]
