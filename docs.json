    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/people-and-organisations",
              "concepts/lifecycle-stages",
              "concepts/objectives",
              "concepts/behaviours",
              "concepts/cohorts",
              "concepts/campaigns",
              "concepts/actions",
              "concepts/signals",
              "concepts/attributes"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/configuring-lifecycle-stages",
              "guides/building-campaigns",
              "guides/using-signals"
            ]
          },
          {
            "group": "Use Cases",
            "pages": [
              "use-cases/onboarding-campaigns",
              "use-cases/adoption-campaigns",
              "use-cases/expansion-campaigns",
              "use-cases/renewal-campaigns"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "faqs"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "hidden": true,
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@trig.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.trig.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/trig"
    }
  }
